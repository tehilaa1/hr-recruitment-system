# Copy to frontend/.env and fill in from:
# Firebase Console → Project settings → General → Your apps → (Web app) → SDK setup and configuration → Config
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=your-project-id.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_APP_ID=

# Optional: Outlook host for mail/calendar drafts (use https://outlook.live.com for personal accounts)
# VITE_OUTLOOK_BASE_URL=https://outlook.office.com

# Optional: the public demo account (see backend/scripts/seed_demo_data.py).
# Shows a "כניסה לחשבון הדגמה" button on the login page. These values are bundled into the
# public JS, so use them ONLY for the demo account (same as the backend's DEMO_EMAIL/DEMO_PASSWORD).
# VITE_DEMO_EMAIL=demo@hiretrack.app
# VITE_DEMO_PASSWORD=...

# Backend API base URL (no trailing slash, no /api suffix — paths already include /api/...)
# Local: http://localhost:8000   Production: https://your-backend.onrender.com
VITE_API_BASE_URL=http://localhost:8000
