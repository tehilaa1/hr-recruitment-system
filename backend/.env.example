GEMINI_API_KEY=your_gemini_api_key_here
GOOGLE_APPLICATION_CREDENTIALS=firebase_credentials.json
GEMINI_MODEL=gemini-3.8-flash
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000"]

# --- SMS verification codes (password reset) ---
# console = simulation: codes are only written to the server log (default)
# twilio  = real SMS; set the three TWILIO_* values
SMS_PROVIDER=console
# TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# TWILIO_AUTH_TOKEN=your_twilio_auth_token
# TWILIO_FROM_NUMBER=+15550000000   (or a Messaging Service SID: MGxxxxxxxx)
# Local testing only — also returns the code to the browser. NEVER in production.
SMS_DEV_MODE=false

# --- Public demo workspace (scripts/seed_demo_data.py) ---
# DEMO_PASSWORD is only needed by the seed script; it must equal the frontend's VITE_DEMO_PASSWORD
# (that value is public — the demo workspace holds sample data only).
# DEMO_EMAIL=demo@hiretrack.app
# DEMO_PASSWORD=
# DEMO_TENANT_ID=demo
# Free-tier protection, applied to the demo workspace only
# DEMO_AI_DAILY_LIMIT=20
# DEMO_MAX_UPLOAD_BYTES=2097152
# DEMO_MAX_FILES_PER_UPLOAD=5
# DEMO_MAX_RECORDS=150
